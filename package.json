{
  "name": "latch-workspace",
  "version": "0.1.0",
  "devDependencies": {
    "@latch/typescript-config": "*",
    "@latch/vitest-config": "*",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fallow": "3.34.0",
    "jsdom": "^30.1.3",
    "react-doctor": "0.9.14",
    "rust-just": "1.58.0",
    "syncpack": "15.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  },
  "packageManager": "npm@11.19.1",
  "private": true,
  "reactDoctor": {
    "deadCode": false,
    "supplyChain": {
      "enabled": false
    },
    "rules": {
      "react-doctor/exhaustive-deps": "off",
      "react-doctor/rules-of-hooks": "off",
      "react-doctor/button-has-type": "off",
      "react-doctor/role-has-required-aria-props": "off",
      "react-doctor/prefer-tag-over-role": "off",
      "react-doctor/no-static-element-interactions": "off",
      "react-doctor/no-noninteractive-element-interactions": "off"
    },
    "ignore": {
      "files": [
        "**/dist/**",
        "**/dist-firefox/**",
        "**/node_modules/**",
        "**/target/**",
        "**/_generated/**",
        ".agents/**",
        ".dev/**",
        "apps/landing/**"
      ]
    },
    "projects": [
      "@latch/desktop",
      "@latch/ui"
    ]
  },
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "build": "npm run typecheck && vp run -r build",
    "build:desktop": "vp -C apps/desktop build",
    "build:landing": "npm run build --workspace @latch/landing",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:quality && npm test",
    "check:all": "npm run check && npm run check:rust && npm run check:protocol && npm run audit && npm run fallow && npm run react-doctor && npm run test:rust && npm run test:seed && npm run test:dev && npm run test:e2e && vp run --filter '@latch/*' --filter '!@latch/landing' build",
    "check:desktop": "npm run check:desktop --workspace @latch/rust-tooling",
    "check:features": "node tooling/quality/features.mjs --check",
    "check:landing": "npm run check --workspace @latch/landing && npm run test --workspace @latch/landing",
    "check:protocol": "npm run check --workspace @latch/codegen",
    "check:rust": "npm run quality --workspace @latch/rust-tooling",
    "cli": "cargo run -p latch-cli --bin latch --",
    "desktop:build": "npm run tauri --workspace @latch/desktop -- build",
    "desktop:bundle": "npm run tauri --workspace @latch/desktop -- build --config src-tauri/tauri.bundle.conf.json",
    "desktop:dev": "npm run tauri --workspace @latch/desktop -- dev",
    "dev": "node tooling/development/frontend.mjs",
    "dev:desktop": "npm run desktop --workspace @latch/development",
    "dev:desktop:shot": "npm run desktop:shot --workspace @latch/development",
    "dev:desktop:status": "npm run desktop:status --workspace @latch/development",
    "dev:desktop:stop": "npm run desktop:stop --workspace @latch/development",
    "dev:desktop:wait": "npm run desktop:wait --workspace @latch/development",
    "dev:landing": "npm run dev --workspace @latch/landing",
    "dev:native": "npm run native --workspace @latch/development",
    "dev:seed": "npm run seed --workspace @latch/seeder",
    "doctor": "node tooling/development/doctor.mjs",
    "fallow": "fallow --no-cache -c tooling/fallow.config.jsonc dead-code --fail-on-issues && fallow --no-cache -c tooling/fallow.config.jsonc architecture --fail-on-issues",
    "fallow:css": "fallow --no-cache -c tooling/fallow.config.jsonc health --css --report-only",
    "fallow:health": "fallow --no-cache -c tooling/fallow.config.jsonc health --hotspots --report-only",
    "format": "npm exec syncpack -- format --config tooling/syncpack.config.json && vp fmt && cargo fmt --all",
    "format:check": "npm exec syncpack -- format --check --config tooling/syncpack.config.json && vp fmt --check && cargo fmt --all -- --check && just --unstable --fmt --check",
    "gen:protocol": "npm run generate --workspace @latch/codegen",
    "hooks:install": "node tooling/hooks/install.mjs",
    "lint": "npm run lint:conventions && npm run lint:packages && vp lint --deny-warnings apps packages tooling vite.config.ts",
    "lint:conventions": "npm run check --workspace @latch/quality && npm run check:features",
    "lint:packages": "npm exec syncpack -- lint --config tooling/syncpack.config.json",
    "precommit": "npm run format:check && npm run lint && npm run typecheck && npm run test:quality && npm test && npm run rust:clippy",
    "react-doctor": "react-doctor -y --no-score --no-supply-chain --blocking warning . --project @latch/desktop,@latch/ui",
    "rust:check": "npm run check --workspace @latch/rust-tooling",
    "rust:clippy": "npm run clippy --workspace @latch/rust-tooling",
    "rust:docs": "npm run docs --workspace @latch/rust-tooling",
    "rust:format": "cargo fmt --all",
    "test": "node tooling/development/with-bridge.mjs npm exec vp -- test run",
    "test:all": "npm run test:rust && npm run test:seed && npm run test:dev && npm run typecheck && npm run test:quality && npm test && npm run test:e2e",
    "test:browser:native": "node tooling/browser-tests/run.mjs",
    "test:dev": "npm run test --workspace @latch/seeder --workspace @latch/development",
    "test:e2e": "node tooling/e2e/run.mjs",
    "test:features": "node tooling/quality/features.mjs",
    "test:landing": "node apps/landing/tooling/test-site.mjs",
    "test:quality": "node --test tooling/quality/*.test.mjs tooling/codegen/*.test.mjs tooling/development/*.test.mjs tooling/hooks/*.test.mjs tooling/e2e/*.test.mjs tooling/release/*.test.mjs",
    "test:rpc": "node tooling/quality/features.mjs rpc",
    "test:rust": "npm run test --workspace @latch/rust-tooling",
    "test:seed": "cargo test --locked -p latch-core --no-default-features --example seed_dev",
    "test:watch": "node tooling/development/with-bridge.mjs npm exec vp -- test",
    "typecheck": "tsc --noEmit",
    "welcome": "bash tooling/development/welcome.sh",
    "workflows": "just --list"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/development",
    "tooling/e2e",
    "tooling/codegen",
    "tooling/quality",
    "tooling/release",
    "tooling/rust",
    "tooling/seeder",
    "tooling/typescript-config",
    "tooling/vite-config",
    "tooling/vitest-config",
    "tooling/web-bridge"
  ]
}
