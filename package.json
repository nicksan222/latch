{
  "name": "latch-workspace",
  "version": "0.1.0",
  "devDependencies": {
    "@latch/typescript-config": "*",
    "@latch/vitest-config": "*",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fallow": "3.34.0",
    "jsdom": "^30.1.3",
    "react-doctor": "0.9.14",
    "rust-just": "1.58.0",
    "syncpack": "15.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24.0.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  },
  "packageManager": "bun@1.4.4",
  "private": true,
  "reactDoctor": {
    "deadCode": false,
    "supplyChain": {
      "enabled": false
    },
    "rules": {
      "react-doctor/exhaustive-deps": "off",
      "react-doctor/rules-of-hooks": "off",
      "react-doctor/button-has-type": "off",
      "react-doctor/role-has-required-aria-props": "off",
      "react-doctor/prefer-tag-over-role": "off",
      "react-doctor/no-static-element-interactions": "off",
      "react-doctor/no-noninteractive-element-interactions": "off"
    },
    "ignore": {
      "files": [
        "**/dist/**",
        "**/dist-firefox/**",
        "**/node_modules/**",
        "**/target/**",
        "**/_generated/**",
        ".agents/**",
        ".dev/**",
        "apps/landing/**"
      ]
    },
    "projects": [
      "@latch/desktop",
      "@latch/ui"
    ]
  },
  "scripts": {
    "audit": "bun audit --audit-level=high",
    "build": "bun run typecheck && vp run -r build",
    "build:desktop": "vp -C apps/desktop build",
    "build:landing": "bun run --filter @latch/landing build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:quality && bun run test",
    "check:all": "bun run check && bun run check:rust && bun run check:protocol && bun run audit && bun run fallow && bun run react-doctor && bun run test:rust && bun run test:seed && bun run test:dev && bun run test:e2e && vp run --filter '@latch/*' --filter '!@latch/landing' build",
    "check:desktop": "bun run --filter @latch/rust-tooling check:desktop",
    "check:features": "node tooling/quality/features.mjs --check",
    "check:landing": "bun run --filter @latch/landing check && bun run --filter @latch/landing test",
    "check:protocol": "bun run --filter @latch/codegen check",
    "check:rust": "bun run --filter @latch/rust-tooling quality",
    "cli": "cargo run -p latch-cli --bin latch --",
    "demo:record": "cargo run --locked -p latch-automation --bin latch-automation -- demo",
    "desktop:build": "bun run --filter @latch/desktop tauri -- build",
    "desktop:bundle": "bun run --filter @latch/desktop tauri -- build --config src-tauri/tauri.bundle.conf.json",
    "desktop:dev": "bun run --filter @latch/desktop tauri -- dev",
    "dev": "node tooling/development/frontend.mjs",
    "dev:desktop": "bun run --filter @latch/development desktop",
    "dev:desktop:shot": "bun run --filter @latch/development desktop:shot",
    "dev:desktop:status": "bun run --filter @latch/development desktop:status",
    "dev:desktop:stop": "bun run --filter @latch/development desktop:stop",
    "dev:desktop:wait": "bun run --filter @latch/development desktop:wait",
    "dev:landing": "bun run --filter @latch/landing dev",
    "dev:native": "bun run --filter @latch/development native",
    "dev:seed": "bun run --filter @latch/seeder seed",
    "doctor": "node tooling/development/doctor.mjs",
    "fallow": "fallow --no-cache -c tooling/fallow.config.jsonc dead-code --fail-on-issues && fallow --no-cache -c tooling/fallow.config.jsonc architecture --fail-on-issues",
    "fallow:css": "fallow --no-cache -c tooling/fallow.config.jsonc health --css --report-only",
    "fallow:health": "fallow --no-cache -c tooling/fallow.config.jsonc health --hotspots --report-only",
    "format": "syncpack format --config tooling/syncpack.config.json && vp fmt && cargo fmt --all",
    "format:check": "syncpack format --check --config tooling/syncpack.config.json && vp fmt --check && cargo fmt --all -- --check && just --unstable --fmt --check",
    "gen:protocol": "bun run --filter @latch/codegen generate",
    "hooks:install": "node tooling/hooks/install.mjs",
    "lint": "bun run lint:conventions && bun run lint:packages && vp lint --deny-warnings apps packages tooling vite.config.ts",
    "lint:conventions": "bun run --filter @latch/quality check && bun run check:features",
    "lint:packages": "syncpack lint --config tooling/syncpack.config.json",
    "precommit": "bun run format:check && bun run lint && bun run typecheck && bun run test:quality && bun run test && bun run rust:clippy",
    "react-doctor": "react-doctor -y --no-score --no-supply-chain --blocking warning . --project @latch/desktop,@latch/ui",
    "rust:check": "bun run --filter @latch/rust-tooling check",
    "rust:clippy": "bun run --filter @latch/rust-tooling clippy",
    "rust:docs": "bun run --filter @latch/rust-tooling docs",
    "rust:format": "cargo fmt --all",
    "test": "node tooling/development/with-bridge.mjs bunx --no-install vp test run",
    "test:all": "bun run test:rust && bun run test:seed && bun run test:dev && bun run typecheck && bun run test:quality && bun run test && bun run test:e2e",
    "test:browser:native": "cargo run --locked -p latch-automation --bin latch-automation -- test-browser",
    "test:dev": "bun run --filter @latch/seeder --filter @latch/development test",
    "test:e2e": "node tooling/e2e/run.mjs",
    "test:features": "node tooling/quality/features.mjs",
    "test:landing": "node apps/landing/tooling/test-site.mjs",
    "test:quality": "node --test tooling/quality/*.test.mjs tooling/codegen/*.test.mjs tooling/development/*.test.mjs tooling/hooks/*.test.mjs tooling/e2e/*.test.mjs tooling/release/*.test.mjs",
    "test:rpc": "node tooling/quality/features.mjs rpc",
    "test:rust": "bun run --filter @latch/rust-tooling test",
    "test:seed": "cargo test --locked -p latch-core --no-default-features --example seed_dev",
    "test:watch": "node tooling/development/with-bridge.mjs bunx --no-install vp test",
    "typecheck": "tsc --noEmit",
    "welcome": "bash tooling/development/welcome.sh",
    "workflows": "just --list"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/development",
    "tooling/e2e",
    "tooling/codegen",
    "tooling/quality",
    "tooling/release",
    "tooling/rust",
    "tooling/seeder",
    "tooling/typescript-config",
    "tooling/vite-config",
    "tooling/vitest-config",
    "tooling/web-bridge"
  ]
}
